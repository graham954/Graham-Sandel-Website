---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
  });
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, prev: entries[i - 1] ?? null, next: entries[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;
const dateStr = data.date
  ? data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---

<Layout title={data.title} description={data.summary}>
  <article class="case">
    <!-- HERO — drenched dark, blue glow ----------------------- -->
    <header class="case-hero section--ink">
      <div class="case-glow" aria-hidden="true"></div>
      <div class="container case-hero-inner">
        <a class="back reveal" href="/work"><span aria-hidden="true">&larr;</span> All work</a>
        <p class="case-cat reveal" style="--reveal-delay:.05s">{data.category}</p>
        <h1 class="case-title reveal" style="--reveal-delay:.1s">{data.title}</h1>
        <p class="lede case-summary reveal" style="--reveal-delay:.16s">{data.summary}</p>
        <div class="case-meta reveal" style="--reveal-delay:.22s">
          {dateStr && <span class="meta-date">{dateStr}</span>}
          {dateStr && data.metric && <span class="meta-sep" aria-hidden="true">&middot;</span>}
          {data.metric && <span class="meta-metric">{data.metric}</span>}
        </div>
      </div>
    </header>

    <!-- BODY — sticky meta rail + editorial prose ------------- -->
    <div class="container case-body">
      <aside class="case-rail">
        <dl class="rail-list reveal">
          <div><dt>Project</dt><dd>{data.category}</dd></div>
          {dateStr && <div><dt>Timeframe</dt><dd>{dateStr}</dd></div>}
          {data.metric && <div><dt>Outcome</dt><dd class="rail-metric">{data.metric}</dd></div>}
          <div>
            <dt>Part of</dt>
            <dd>
              <a href="https://childreninarts.com" target="_blank" rel="noopener">
                Children in the Arts <span aria-hidden="true">&#8599;</span>
              </a>
            </dd>
          </div>
        </dl>
      </aside>

      <div class="case-content prose reveal">
        <Content />
      </div>
    </div>

    <!-- PREV / NEXT ------------------------------------------- -->
    {(prev || next) && (
      <nav class="case-nav" aria-label="More projects">
        <div class="container case-nav-inner">
          {prev ? (
            <a class="case-nav-link" href={`/work/${prev.slug}`}>
              <span class="nav-dir"><span aria-hidden="true">&larr;</span> Previous</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="case-nav-link is-next" href={`/work/${next.slug}`}>
              <span class="nav-dir">Next <span aria-hidden="true">&rarr;</span></span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </div>
      </nav>
    )}
  </article>
</Layout>

<style>
  /* HERO ------------------------------------------------------- */
  .case-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.8rem, 6vw, 4.5rem);
  }
  /* soft blue light bleeding in from the upper-right corner */
  .case-glow {
    position: absolute;
    top: -32%;
    right: -8%;
    width: min(620px, 78vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--flare) 0%, transparent 68%);
    opacity: 0.42;
    filter: blur(46px);
    pointer-events: none;
  }
  .case-hero-inner { position: relative; z-index: 1; }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--on-ink-muted);
    transition: color 0.3s var(--ease-out);
    margin-bottom: 1.6rem;
  }
  .back:hover { color: var(--paper); }

  .case-cat {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--on-ink);
    border: 1.5px solid var(--line-on-ink);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.3rem;
  }
  .case-title {
    font-size: var(--step-4);
    color: var(--paper);
    max-width: 17ch;
  }
  .case-summary {
    color: var(--on-ink);
    max-width: 56ch;
    margin-top: 1.3rem;
  }
  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }
  .meta-date {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--on-ink-muted);
  }
  .meta-sep { color: var(--on-ink-muted); opacity: 0.6; }
  .meta-metric {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--on-flare);
    background: var(--flare);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
  }

  /* BODY ------------------------------------------------------- */
  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
    align-items: start;
  }

  .case-rail { position: sticky; top: 96px; }
  .rail-list { border-top: 2px solid var(--ink); }
  .rail-list > div {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }
  .rail-list dt { font-size: 0.9rem; color: var(--text-muted); }
  .rail-list dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .rail-metric { color: var(--flare); }
  .rail-list dd a {
    color: var(--flare);
    transition: opacity 0.3s var(--ease-out);
  }
  .rail-list dd a:hover { opacity: 0.7; }

  /* PROSE — editorial, distinct from the body text elsewhere --- */
  .case-content { max-width: 68ch; }
  .case-content :global(p) {
    margin-bottom: 1.2rem;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.68;
  }
  /* opening paragraph reads as a lead-in */
  .case-content :global(p:first-of-type) {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 1.8rem;
  }
  .case-content :global(strong) { color: var(--ink); font-weight: 700; }
  .case-content :global(a) {
    color: var(--flare);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
  }
  .case-content :global(a:hover) { color: var(--flare-deep); }

  /* section headings get the brand diamond marker */
  .case-content :global(h2) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--step-2);
    margin: 2.6rem 0 1rem;
  }
  .case-content :global(h2)::before {
    content: '';
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--flare);
    border-radius: 3px;
    transform: rotate(45deg);
  }

  /* outcome / result bullets */
  .case-content :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.2rem 0 1.5rem;
  }
  .case-content :global(li) {
    position: relative;
    padding-left: 1.7rem;
    color: var(--ink);
    font-weight: 500;
  }
  .case-content :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.6rem;
    height: 0.6rem;
    background: var(--flare);
    border-radius: 2px;
    transform: rotate(45deg);
  }

  /* PREV / NEXT ------------------------------------------------ */
  .case-nav { border-top: 1px solid var(--line); }
  .case-nav-inner {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(2.2rem, 4vw, 3.2rem);
  }
  .case-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 46%;
  }
  .case-nav-link.is-next { text-align: right; align-items: flex-end; margin-left: auto; }
  .nav-dir {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .nav-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    transition: color 0.3s var(--ease-out);
  }
  .case-nav-link:hover .nav-title { color: var(--flare); }

  /* RESPONSIVE ------------------------------------------------- */
  @media (max-width: 820px) {
    .case-body { grid-template-columns: 1fr; gap: 2rem; }
    .case-rail { position: static; }
    .rail-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem;
    }
  }
  @media (max-width: 520px) {
    .case-nav-link { max-width: 100%; }
    .rail-list { grid-template-columns: 1fr; }
  }
</style>
