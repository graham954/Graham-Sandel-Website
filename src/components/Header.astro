---
const links = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/leadership', label: 'Leadership' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Graham Sandel — home">
      <span class="brand-mark">GS</span>
      <span class="brand-name">Graham&nbsp;Sandel</span>
    </a>

    <nav class="site-nav" id="siteNav" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class:list={['nav-link', { active: path === l.href }]}>
            {l.label}
          </a>
        ))
      }
      <a href="/contact" class="btn btn--primary nav-cta">Get in touch<span class="arr">&rarr;</span></a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="siteNav">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in oklch, var(--paper) 80%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.65rem; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px; height: 38px;
    background: var(--ink);
    color: var(--flare);
    border-radius: 11px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .site-nav { display: flex; align-items: center; gap: 1.9rem; }
  .nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-muted);
    transition: color 0.25s var(--ease-out);
    position: relative;
    padding-block: 0.3rem;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 2px;
    background: var(--flare);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after,
  .nav-link.active::after { transform: scaleX(1); }
  .nav-link.active { color: var(--ink); }
  .nav-cta { padding: 0.6rem 1.2rem; font-size: 0.95rem; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px; height: 44px;
    background: none;
    border: 0;
  }
  .nav-toggle span {
    width: 26px; height: 2.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out), opacity 0.2s linear;
  }
  .nav-toggle[aria-expanded='true'] span:first-child { transform: translateY(4.5px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 800px) {
    .nav-toggle { display: flex; }
    .site-nav {
      position: fixed;
      inset: 74px 0 auto 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
      padding: 2rem var(--gutter) 2.4rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      transform: translateY(-115%);
      transition: transform 0.4s var(--ease-out);
      z-index: var(--z-nav);
    }
    .site-nav.is-open { transform: none; }
    .nav-link { font-size: 1.4rem; }
    .nav-cta { width: 100%; justify-content: center; margin-top: 0.5rem; }
  }
</style>
