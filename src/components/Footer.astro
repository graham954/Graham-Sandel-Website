---
import { socials, email } from '../data/site';
---

<footer class="site-footer section--ink">
  <div class="container">
    <div class="footer-cta">
      <p class="footer-eyebrow">Say hello</p>
      <a class="footer-mail" href={`mailto:${email}`}>
        {email}<span class="arr" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="footer-grid">
      <p class="footer-tag">
        Built and run by Graham Sandel &mdash; student leader, DECA state officer,
        and founder of Children in the Arts.
      </p>
      <nav class="footer-col" aria-label="Footer">
        <span class="footer-label">Pages</span>
        <a href="/about">About</a>
        <a href="/work">Work</a>
        <a href="/leadership">Leadership</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="footer-col">
        <span class="footer-label">Elsewhere</span>
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} Graham Sandel</span>
      <span>Lexington, South Carolina</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(4rem, 8vw, 6.5rem) 2.2rem; }
  .footer-eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--flare) !important;
    margin-bottom: 0.8rem;
  }
  .footer-cta { padding-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line-on-ink); }
  .footer-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.8rem, 5.5vw, 4rem);
    letter-spacing: -0.03em;
    color: var(--paper);
    line-height: 1;
    word-break: break-word;
  }
  .footer-mail .arr { transition: transform 0.4s var(--ease-out); color: var(--flare); }
  .footer-mail:hover .arr { transform: translateX(8px); }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .footer-tag { max-width: 34ch; font-size: 1.05rem; }
  .footer-col { display: flex; flex-direction: column; gap: 0.85rem; }
  .footer-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    margin-bottom: 0.2rem;
  }
  .footer-col a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--on-ink);
    width: fit-content;
    transition: color 0.25s var(--ease-out);
  }
  .footer-col a:hover { color: var(--flare); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-on-ink);
    font-size: 0.9rem;
    color: var(--on-ink-muted);
  }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-tag { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; gap: 0.3rem; }
  }
</style>
